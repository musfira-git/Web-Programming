<html>
<head>
<title>mouse event</title>
</head>

<body style="text-align:center">
<h2>Mouse Handling</h2>
<img id="img-tag"
 src="https://marketplace.canva.com/FXElA/MAG6QPFXElA/1/tl/canva-vibrant-abstract-waves-of-color-and-light-MAG6QPFXElA.jpg";
 onmouseover="changeImg()"
 onmouseout="setOld()"
 width="220px"
 height="230px"
 alt="image">
<script>
 function changeImg()
 {
  document.getElementById("img-tag").src=
    "https://images.unsplash.com/photo-1604871000636-074fa5117945?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D";
    }
 function setOld()
 {
   document.getElementById("img-tag").src=
     "https://marketplace.canva.com/FXElA/MAG6QPFXElA/1/tl/canva-vibrant-abstract-waves-of-color-and-light-MAG6QPFXElA.jpg";
     }
</script>
</body>
</html>


